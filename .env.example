# このファイルをコピーして .env を作り、値を埋める:
#   cp .env.example .env
# koshien は起動時に .env を自動読み込みする(既存の環境変数があればそちらが優先)。
# .env はシークレットなのでコミットしない(.gitignore 済み)。

# Wikimedia の User-Agent ポリシー: 連絡先入りが必須(未設定だと fetch が失敗する)
KOSHIEN_UA='koshien-db/0.1 (your-name; you@example.com)'

# Supabase の Postgres 接続文字列(パスワード入り = サービスロール相当。RLS を迂回する)
# 取得: Supabase Dashboard > Connect > Session pooler
#
# 通常は下記の Session pooler(IPv4 対応・ユーザー名は postgres.<PROJECT_REF>)を使う。
SUPABASE_DSN='postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'
#
# ↓ direct 接続(db.<ref>.supabase.co)は IPv6 専用。
#   IPv4 のみの環境(WSL2 など)からは "Network is unreachable" になるので使わない。
# SUPABASE_DSN='postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres'
